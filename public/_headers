# ============================================================
# Likelink — public response headers (Netlify format)
# ------------------------------------------------------------
# SEO / AI-search:
#   "X-Robots-Tag: index, follow, max-image-preview:large..." is intentionally
#   WITHOUT "noai" / "noimageai" / "noindex" so Google AI Search, AI Overviews
#   and Search Console can crawl, index, and surface Likelink freely.
#
# Security / privacy (safe defaults that never block crawlers):
#   - Referrer-Policy, X-Content-Type-Options, Permissions-Policy
#   - No CSP is enforced here on purpose: a strict CSP could block the app's
#     inline debug script and Google Fonts. Add one in the React source if a
#     stricter policy is desired.
# ============================================================

/*
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-DNS-Prefetch-Control: off
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  X-Robots-Tag: noindex, follow
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable