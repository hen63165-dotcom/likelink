# Copy this file to .env and fill in your own Supabase project values
# (Settings -> API in the Supabase dashboard). Never commit the real .env file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Admin panel access code. Keep it long & random. If omitted, the admin panel
# stays locked (it is never baked into the published JS bundle).
VITE_ADMIN_CODE=replace-with-a-long-random-string

# Google Merchant Center feed overrides (optional — used by the /api/google-feed
# endpoint and the `npm run feed:google` CLI script; defaults are shown).
# LIKELINK_BASE_URL=https://www.likelink.com
# LIKELINK_CURRENCY=ILS
# LIKELINK_BRAND=Likelink
