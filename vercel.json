{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/autopilot?cron=daily",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/price-watch",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/google-feed?kind=sitemap"
    },
    {
      "source": "/discover.xml",
      "destination": "/api/google-feed?kind=discover"
    },
    {
      "source": "/google-feed.xml",
      "destination": "/api/google-feed?kind=google"
    },
    {
      "source": "/r",
      "destination": "/api/og?mode=r"
    },
    {
      "source": "/api/r",
      "destination": "/api/og?mode=r"
    },
    {
      "source": "/api/sitemap",
      "destination": "/api/google-feed?kind=sitemap"
    },
    {
      "source": "/u/:slug",
      "destination": "/api/og?slug=:slug"
    },
    {
      "source": "/p/:id",
      "destination": "/api/og?id=:id"
    },
    {
      "source": "/grow/:id",
      "destination": "/api/og?mode=growth&id=:id"
    },
    {
      "source": "/story/:id",
      "destination": "/api/google-feed?kind=story&id=:id"
    },
    {
      "source": "/api/push",
      "destination": "/api/store?mode=push"
    },
    {
      "source": "/api/gpt/openapi.json",
      "destination": "/api/store?mode=gpt&op=openapi"
    },
    {
      "source": "/api/gpt/products",
      "destination": "/api/store?mode=gpt&op=products"
    },
    {
      "source": "/api/gpt/products/:productId/tracking-link",
      "destination": "/api/store?mode=gpt&op=tracking-link&productId=:productId"
    },
    {
      "source": "/api/gpt/drafts",
      "destination": "/api/store?mode=gpt&op=drafts"
    },
    {
      "source": "/api/gpt/drafts/:draftId",
      "destination": "/api/store?mode=gpt&op=draft&draftId=:draftId"
    },
    {
      "source": "/api/sign-sale",
      "destination": "/api/store?mode=sign-sale"
    },
    {
      "source": "/api/fetch-product-info",
      "destination": "/api/og?mode=fetch"
    },
    {
      "source": "/feed",
      "destination": "/"
    },
    {
      "source": "/creators",
      "destination": "/"
    },
    {
      "source": "/creators/:path*",
      "destination": "/"
    },
    {
      "source": "/merchants",
      "destination": "/"
    },
    {
      "source": "/merchants/:path*",
      "destination": "/"
    },
    {
      "source": "/discover",
      "destination": "/"
    },
    {
      "source": "/discover/:path*",
      "destination": "/"
    },
    {
      "source": "/feed/:path*",
      "destination": "/"
    },
    {
      "source": "/studio",
      "destination": "/"
    },
    {
      "source": "/studio/:path*",
      "destination": "/"
    },
    {
      "source": "/sell",
      "destination": "/"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/owner",
      "destination": "/"
    },
    {
      "source": "/admin/:path*",
      "destination": "/"
    },
    {
      "source": "/reels",
      "destination": "/"
    },
    {
      "source": "/trends",
      "destination": "/"
    },
    {
      "source": "/deals",
      "destination": "/"
    },
    {
      "source": "/search",
      "destination": "/"
    },
    {
      "source": "/saved",
      "destination": "/"
    },
    {
      "source": "/products",
      "destination": "/"
    },
    {
      "source": "/products/:path*",
      "destination": "/"
    },
    {
      "source": "/collections",
      "destination": "/"
    },
    {
      "source": "/collections/:path*",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml|manifest.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        }
      ]
    }
  ]
}
